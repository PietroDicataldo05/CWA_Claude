# Gemini API Key (Server side)
GEMINI_API_KEY=

# Supabase (Project Settings -> API)
# URL e anon key sono esposte al browser (prefisso VITE_ richiesto da Vite).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Usate SOLO lato server (server.ts, script in supabase/). Non aggiungere
# mai il prefisso VITE_ a queste due o finirebbero nel bundle pubblico.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
